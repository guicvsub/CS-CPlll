<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WpfApp1.ViewModels"
        mc:Ignorable="d"
        Title="Help Desk Pro" Height="720" Width="1150"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="20,28,20,32">
                    <TextBlock Text="🖥️  HelpDesk" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Sistema de Chamados" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Nav Items -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0">
                    <TextBlock Text="MENU" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="14,0,0,8"/>
                    <RadioButton Content="Chamados" IsChecked="{Binding ShowChamados, Mode=TwoWay}" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <RadioButton Content="Clientes" IsChecked="{Binding ShowClientes, Mode=TwoWay}" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <RadioButton Content="Departamentos" IsChecked="{Binding ShowDepartamentos, Mode=TwoWay}" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <RadioButton Content="Tecnicos" IsChecked="{Binding ShowTecnicos, Mode=TwoWay}" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Bottom stats -->
                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,24">
                    <Separator Background="#334155" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top header bar -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding CurrentPageTitle}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentPageSubtitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ Novo Registro" Style="{StaticResource PrimaryBtn}" Command="{Binding OpenAddDialogCommand}" Width="160"/>
                </Grid>
            </Border>

            <!-- Content Switcher -->
            <Grid Grid.Row="1" Margin="28">

                <!-- ===== CHAMADOS VIEW ===== -->
                <Grid Visibility="{Binding ShowChamados, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Status summary pills -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,16">
                        <Border Background="#1a3a5c" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#60a5fa" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalChamados, StringFormat='Total: {0}'}" Foreground="White" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1a3a2a" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#10b981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ChamadosResolvidos, StringFormat='Resolvidos: {0}'}" Foreground="White" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#3a1a1a" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#ef4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ChamadosAbertos, StringFormat='Abertos: {0}'}" Foreground="White" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Chamados Table -->
                    <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0" ItemsSource="{Binding Chamados}" SelectedItem="{Binding SelectedChamado}" Margin="4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="TÍTULO" Binding="{Binding Titulo}" Width="*"/>
                                    <DataGridTextColumn Header="CLIENTE" Binding="{Binding NomeCliente}" Width="160"/>
                                    <DataGridTemplateColumn Header="PRIORIDADE" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Prioridade}" Value="Alta">
                                                                    <Setter Property="Background" Value="#7f1d1d"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Prioridade}" Value="Média">
                                                                    <Setter Property="Background" Value="#78350f"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Prioridade}" Value="Baixa">
                                                                    <Setter Property="Background" Value="#14532d"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Prioridade}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="STATUS" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Aberto">
                                                                    <Setter Property="Background" Value="#1e3a5f"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Em atendimento">
                                                                    <Setter Property="Background" Value="#78350f"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Resolvido">
                                                                    <Setter Property="Background" Value="#14532d"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="TÉCNICO" Binding="{Binding NomeTecnico}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Action Bar -->
                            <Border Grid.Row="1" Background="{StaticResource CardLighterBrush}" CornerRadius="0,0,12,12" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Seletor de Tecnico para Atender -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Atribuir a:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding Tecnicos}" SelectedItem="{Binding TecnicoParaAtender}" DisplayMemberPath="Nome" Width="200" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Botoes de acao -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Atender" Style="{StaticResource OrangeBtn}" Command="{Binding AtenderCommand}" Margin="0,0,8,0" Padding="14,8"/>
                                        <Button Content="Finalizar" Style="{StaticResource GreenBtn}" Command="{Binding FinalizarCommand}" Margin="0,0,8,0" Padding="14,8"/>
                                        <Button Content="Editar" Style="{StaticResource PrimaryBtn}" Command="{Binding EditCommand}" Margin="0,0,8,0" Padding="14,8"/>
                                        <Button Content="Excluir" Style="{StaticResource RedBtn}" Command="{Binding DeleteCommand}" Padding="14,8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== CLIENTES VIEW ===== -->
                <Border Visibility="{Binding ShowClientes, Converter={StaticResource BoolToVis}}" Background="{StaticResource CardBrush}" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding Clientes}" SelectedItem="{Binding SelectedCliente}" Margin="4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="*"/>
                                <DataGridTextColumn Header="EMPRESA" Binding="{Binding Empresa}" Width="200"/>
                                <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="200"/>
                                <DataGridTextColumn Header="TELEFONE" Binding="{Binding Telefone}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Background="{StaticResource CardLighterBrush}" CornerRadius="0,0,12,12" Padding="12,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="✎ Editar" Style="{StaticResource PrimaryBtn}" Command="{Binding EditCommand}" Margin="0,0,8,0" Padding="14,8"/>
                                <Button Content="✕ Excluir" Style="{StaticResource RedBtn}" Command="{Binding DeleteCommand}" Padding="14,8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== DEPARTAMENTOS VIEW ===== -->
                <Border Visibility="{Binding ShowDepartamentos, Converter={StaticResource BoolToVis}}" Background="{StaticResource CardBrush}" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding Departamentos}" SelectedItem="{Binding SelectedDepartamento}" Margin="4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="*"/>
                                <DataGridTextColumn Header="RESPONSÁVEL" Binding="{Binding Responsavel}" Width="220"/>
                                <DataGridCheckBoxColumn Header="ATIVO" Binding="{Binding Ativo}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Background="{StaticResource CardLighterBrush}" CornerRadius="0,0,12,12" Padding="12,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="✎ Editar" Style="{StaticResource PrimaryBtn}" Command="{Binding EditCommand}" Margin="0,0,8,0" Padding="14,8"/>
                                <Button Content="✕ Excluir" Style="{StaticResource RedBtn}" Command="{Binding DeleteCommand}" Padding="14,8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== TÉCNICOS VIEW ===== -->
                <Border Visibility="{Binding ShowTecnicos, Converter={StaticResource BoolToVis}}" Background="{StaticResource CardBrush}" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding Tecnicos}" SelectedItem="{Binding SelectedTecnico}" Margin="4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="*"/>
                                <DataGridTextColumn Header="ESPECIALIDADE" Binding="{Binding Especialidade}" Width="200"/>
                                <DataGridCheckBoxColumn Header="DISPONÍVEL" Binding="{Binding Disponivel}" Width="100"/>
                                <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Background="{StaticResource CardLighterBrush}" CornerRadius="0,0,12,12" Padding="12,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="✎ Editar" Style="{StaticResource PrimaryBtn}" Command="{Binding EditCommand}" Margin="0,0,8,0" Padding="14,8"/>
                                <Button Content="✕ Excluir" Style="{StaticResource RedBtn}" Command="{Binding DeleteCommand}" Padding="14,8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== FORM OVERLAY ===== -->
                <Grid Visibility="{Binding ShowForm, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10">
                    <Rectangle Fill="#0f172a" Opacity="0.7"/>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="32" Width="520"
                            MaxHeight="620"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{Binding FormTitle}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,24"/>

                            <!-- Chamado Fields -->
                            <StackPanel Visibility="{Binding ShowChamados, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Título *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormTitulo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <TextBlock Text="Descrição" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormDescricao, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14"/>
                                <TextBlock Text="Prioridade *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Prioridades}" SelectedItem="{Binding FormPrioridade}" Margin="0,0,0,14"/>
                                <TextBlock Text="Nome do Cliente *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormNomeCliente, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <TextBlock Text="Tecnico Responsavel (opcional)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Tecnicos}" SelectedItem="{Binding FormTecnicoSelecionado}" DisplayMemberPath="Nome" Margin="0,0,0,4"/>
                                <TextBlock Text="Deixe vazio para nao atribuir agora" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,14" FontStyle="Italic"/>
                            </StackPanel>

                            <!-- Cliente Fields -->
                            <StackPanel Visibility="{Binding ShowClientes, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Nome *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormNome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <TextBlock Text="Empresa" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormEmpresa, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <TextBlock Text="Email" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <TextBlock Text="Telefone" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormTelefone, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Departamento Fields -->
                            <StackPanel Visibility="{Binding ShowDepartamentos, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Nome *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormNome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <TextBlock Text="Responsável" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormResponsavel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <CheckBox Content="Ativo" IsChecked="{Binding FormAtivo}" Foreground="White"/>
                            </StackPanel>

                            <!-- Tecnico Fields -->
                            <StackPanel Visibility="{Binding ShowTecnicos, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Nome *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormNome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <TextBlock Text="Especialidade" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormEspecialidade, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <TextBlock Text="Email" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <CheckBox Content="Disponível" IsChecked="{Binding FormDisponivel}" Foreground="White"/>
                            </StackPanel>

                            <!-- Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                                <Button Content="Cancelar" Style="{StaticResource GhostBtn}" Command="{Binding CancelFormCommand}" Margin="0,0,10,0" Width="110"/>
                                <Button Content="Salvar" Style="{StaticResource PrimaryBtn}" Command="{Binding SaveCommand}" Width="110"/>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
